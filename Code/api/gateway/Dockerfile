FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./

ARG RECIPE_SERVICE_URL=$RECIPE_SERVICE_URL
ARG FRIDGE_SERVICE_URL=$FRIDGE_SERVICE_URL
ARG USERS_SERVICE_URL=$USERS_SERVICE_URL

ENV RECIPE_SERVICE_URL=$RECIPE_SERVICE_URL
ENV FRIDGE_SERVICE_URL=$FRIDGE_SERVICE_URL
ENV USERS_SERVICE_URL=$USERS_SERVICE_URL
RUN npm install && npm ci --omit=dev

FROM node:20-alpine
ENV RECIPE_SERVICE_URL=$RECIPE_SERVICE_URL
ENV FRIDGE_SERVICE_URL=$FRIDGE_SERVICE_URL
ENV USERS_SERVICE_URL=$USERS_SERVICE_URL
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 3000
CMD ["node", "index.js"]